    "views": [
      {
        "id": "main-path",
        "label": "从 spec 到报告",
        "focus": [
          "user",
          "plan",
          "confirm",
          "run",
          "doctor",
          "netlist",
          "optimize",
          "report",
          "result"
        ],
        "note": "写 spec.yaml 和 recipe，--plan 预览后运行；Block 依次执行，最后读报告与观测表。"
      },
      {
        "id": "evaluate-loop",
        "label": "suggest ⇄ evaluate",
        "focus": [
          "optimize",
          "evaluate",
          "sim",
          "store"
        ],
        "note": "optimize 只是循环：suggest 出点，evaluate 经 Executor 仿真并追加观测；fix-run 只是把 suggest 换成 points_fixed。"
      },
      {
        "id": "guardrails",
        "label": "护栏",
        "focus": [
          "plan",
          "confirm",
          "evaluate",
          "guard"
        ],
        "note": "唯一的审批点是 --plan；运行中预算 / 资源包络 / license / 锁是不变量，超限即停，已完成观测保留。"
      }
    ]
