  "cards": [
    {
      "dot": "cyan",
      "title": "已有能力（不用再开发）",
      "items": [
        "锚点在 library.yaml 声明，改频率 = 加一个数字，数据集 10 s/层重算",
        "每个量一个 GP，留出 5 折校准区间；域守卫只在采样域内作答",
        "lib.query / lib.suggest / lib_signoff 回流，昨日 10 点真实复核覆盖 94.6%"
      ]
    },
    {
      "dot": "amber",
      "title": "本次新增（脚本已写好，约 250 行）",
      "items": [
        "5 维网格 + 分块预测（10^5–10^6 点，几分钟）",
        "两级筛选：2σ 稳健集 / 均值集；按维、按线宽对、k–CS 汇总",
        "做成正式 block lib.region 含测试与文档：约 1–2 天"
      ]
    },
    {
      "dot": "rose",
      "title": "60 GHz 与 40 GHz 的差别",
      "items": [
        "可用行减少：SRF 须 ≥ 75 GHz（AP 1291→1022，M10 1234→965）",
        "目标窗：Lp、Ls 150–170 pH，Q > 10，k 0.5–0.7；60 GHz 的 Q 更高（min(Qp,Qs) 7–16），实测命中 8 / 5 行",
        "域边界处 σ 偏大，稳健集比均值集窄；超出库覆盖范围模型拒答"
      ]
    }
